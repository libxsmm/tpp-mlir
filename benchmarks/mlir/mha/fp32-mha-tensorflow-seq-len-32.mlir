// RUN: tpp-run %s -n 5 \
// RUN:  -e entry -entry-point-result=void

// BENCH_TOTAL_FLOPS: 3355443200

#map = affine_map<(d0, d1, d2, d3, d4) -> (d0, d1, d2)>
#map1 = affine_map<(d0, d1, d2, d3, d4) -> (d2, d3, d4)>
#map2 = affine_map<(d0, d1, d2, d3, d4) -> (d0, d1, d3, d4)>
#map3 = affine_map<(d0, d1, d2, d3) -> (d0, d1, d2, d3)>
#map4 = affine_map<(d0, d1, d2, d3, d4) -> (d0, d1, d2, d3)>
#map5 = affine_map<(d0, d1, d2, d3, d4) -> (d0, d4, d2, d3)>
#map6 = affine_map<(d0, d1, d2, d3, d4) -> (d0, d2, d4, d1)>
#map7 = affine_map<(d0, d1, d2, d3) -> (d0, d1, d2)>
#map8 = affine_map<(d0, d1, d2, d3) -> (d0, d1, d2, 0)>
#map9 = affine_map<(d0, d1, d2, d3, d4) -> (d0, d3, d1, d4)>
#map10 = affine_map<(d0, d1, d2, d3, d4) -> (d0, d2, d1, d4)>
#map11 = affine_map<(d0, d1, d2, d3, d4) -> (d0, d1, d4)>
module {
  func.func @entry(%arg0: tensor<64x32x512xf32>, %arg1: tensor<64x32x512xf32>, %arg2: tensor<64x32x512xf32>, %out_b: tensor<64x32x512xf32>) -> tensor<64x32x512xf32> {
    %cst = arith.constant -0.000000e+00 : f32
    %cst_0 = arith.constant 0xFF800000 : f32
    %cst_1 = arith.constant 0.000000e+00 : f32
    %cst_2 = arith.constant dense<1.250000e-01> : tensor<64x32x8x64xf32>
    %cst_3 = arith.constant dense<""> : tensor<512x8x64xf32>
    %cst_4 = arith.constant dense<""> : tensor<512x8x64xf32>
    %cst_5 = arith.constant dense<""> : tensor<512x8x64xf32>
    %cst_6 = arith.constant dense<""> : tensor<8x64x512xf32>


    %0 = tensor.empty() : tensor<64x32x8x64xf32>
    %1 = linalg.fill ins(%cst_1 : f32) outs(%0 : tensor<64x32x8x64xf32>) -> tensor<64x32x8x64xf32>
    %2 = linalg.generic {
      "__projection_V__",
      indexing_maps = [#map, #map1, #map2],
      iterator_types = ["parallel", "parallel", "reduction", "parallel", "parallel"]}
      ins(%arg2, %cst_3 : tensor<64x32x512xf32>, tensor<512x8x64xf32>) outs(%1 : tensor<64x32x8x64xf32>) {
    ^bb0(%in: f32, %in_8: f32, %out: f32):
      %23 = arith.mulf %in, %in_8 : f32
      %24 = arith.addf %out, %23 : f32
      linalg.yield %24 : f32
    } -> tensor<64x32x8x64xf32>

    %fill_1 = linalg.fill ins(%cst_1 : f32) outs(%0 : tensor<64x32x8x64xf32>) -> tensor<64x32x8x64xf32>
    %3 = linalg.generic {
      "__projection_Q__",
      indexing_maps = [#map, #map1, #map2],
      iterator_types = ["parallel", "parallel", "reduction", "parallel", "parallel"]}
      ins(%arg0, %cst_4 : tensor<64x32x512xf32>, tensor<512x8x64xf32>) outs(%fill_1 : tensor<64x32x8x64xf32>) {
    ^bb0(%in: f32, %in_8: f32, %out: f32):
      %23 = arith.mulf %in, %in_8 : f32
      %24 = arith.addf %out, %23 : f32
      linalg.yield %24 : f32
    } -> tensor<64x32x8x64xf32>

    %fill_2 = linalg.fill ins(%cst_1 : f32) outs(%0 : tensor<64x32x8x64xf32>) -> tensor<64x32x8x64xf32>
    %5 = linalg.generic {
      "__projection_K__",
      indexing_maps = [#map, #map1, #map2],
      iterator_types = ["parallel", "parallel", "reduction", "parallel", "parallel"]}
      ins(%arg1, %cst_5 : tensor<64x32x512xf32>, tensor<512x8x64xf32>) outs(%fill_2 : tensor<64x32x8x64xf32>) {
    ^bb0(%in: f32, %in_8: f32, %out: f32):
      %23 = arith.mulf %in, %in_8 : f32
      %24 = arith.addf %out, %23 : f32
      linalg.yield %24 : f32
    } -> tensor<64x32x8x64xf32>

    %6 = tensor.empty() : tensor<64x8x32x32xf32>
    %7 = linalg.fill ins(%cst_1 : f32) outs(%6 : tensor<64x8x32x32xf32>) -> tensor<64x8x32x32xf32>
    %8 = linalg.generic {
      "__Q_times_K__",
      indexing_maps = [#map4, #map5, #map6],
      iterator_types = ["parallel", "parallel", "parallel", "reduction", "parallel"]}
      ins(%5, %3 : tensor<64x32x8x64xf32>, tensor<64x32x8x64xf32>) outs(%7 : tensor<64x8x32x32xf32>) {
    ^bb0(%in: f32, %in_8: f32, %out: f32):
      %23 = arith.mulf %in, %in_8 : f32
      %24 = arith.addf %out, %23 : f32
      linalg.yield %24 : f32
    } -> tensor<64x8x32x32xf32>

    %fill_3 = linalg.fill ins(%cst_1 : f32) outs(%0 : tensor<64x32x8x64xf32>) -> tensor<64x32x8x64xf32>
    %19 = linalg.generic {
      "__Softmax_times_V__",
      indexing_maps = [#map4, #map9, #map10],
      iterator_types = ["parallel", "parallel", "parallel", "reduction", "parallel"]}
    ins(%8, %2 : tensor<64x8x32x32xf32>, tensor<64x32x8x64xf32>) outs(%fill_3 : tensor<64x32x8x64xf32>) {
    ^bb0(%in: f32, %in_8: f32, %out: f32):
      %23 = arith.mulf %in, %in_8 : f32
      %24 = arith.addf %out, %23 : f32
      linalg.yield %24 : f32
    } -> tensor<64x32x8x64xf32>

    %21 = linalg.fill ins(%cst_1 : f32) outs(%out_b : tensor<64x32x512xf32>) -> tensor<64x32x512xf32>
    %22 = linalg.generic {
      "__projection_Wo__",
      indexing_maps = [#map4, #map1, #map11],
      iterator_types = ["parallel", "parallel", "reduction", "reduction", "parallel"]}
      ins(%19, %cst_6 : tensor<64x32x8x64xf32>, tensor<8x64x512xf32>) outs(%21 : tensor<64x32x512xf32>) {
    ^bb0(%in: f32, %in_8: f32, %out: f32):
      %23 = arith.mulf %in, %in_8 : f32
      %24 = arith.addf %out, %23 : f32
      linalg.yield %24 : f32
    } -> tensor<64x32x512xf32>
    return %22 : tensor<64x32x512xf32>
  }
}
